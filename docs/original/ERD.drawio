        <mxCell id="lQPzUekYGvBKQJdySmww-1" value="&lt;div&gt;&lt;b&gt;&lt;font style=&quot;font-size: 24px;&quot;&gt;RNE&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;font style=&quot;font-size: 24px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;País&lt;/font&gt;&lt;/div&gt;&lt;div&gt;CodPais: código de 3 letras.&lt;/div&gt;&lt;div&gt;Continente: solo puede ser AF, OC, EU, AS o AA.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Autor&lt;/font&gt;&lt;/div&gt;&lt;div&gt;CodAutor: combinación de 10 letras y números.&lt;/div&gt;&lt;div&gt;FechaNacimiento: el autor debe ser mayor o igual a 18 años.&lt;/div&gt;&lt;div&gt;FechaDefuncion: no puede ser menor a la fecha de nacimiento, no puede ser posterior a hoy, acepta valores nulos.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Librería&lt;/font&gt;&lt;/div&gt;&lt;div&gt;RUT: debe contener unicamente 12 dígitos.&lt;/div&gt;&lt;div&gt;NomUsuL: entre 8 y 15 caracteres y único en el sistema.&lt;/div&gt;&lt;div&gt;PassUsuL: mínimo 8 caracteres, debe contener al menos 1 letra, 1 número y 1 símbolo.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Editorial&lt;/font&gt;&lt;/div&gt;&lt;div&gt;NomUsuE: entre 8 y 15 caracteres y único en el sistema.&lt;/div&gt;&lt;div&gt;PassUsuE: mínimo 8 caracteres, debe contener al menos 1 letra, 1 número y 1 símbolo.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;L&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;ibro&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;El ISBN debe ser de 13 numeros.&lt;/div&gt;&lt;div&gt;El stock no puede ser negativo.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Solicitud&lt;/font&gt;&lt;/div&gt;&lt;div&gt;FechaSolicitud: automática.&lt;/div&gt;&lt;div&gt;FechaEntrega: debe ser al menos 24 horas posterior a la solicitud.&lt;/div&gt;&lt;div&gt;Solo se podrán solicitar libros con stock disponible.&lt;/div&gt;&lt;div&gt;La cantidad solicitada debe ser mayor a 0.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;shadow=0;fillColor=#1ba1e2;fontColor=light-dark(#ffffff, #000000);strokeColor=#006EAF;" parent="1" vertex="1">
          <mxGeometry x="30" y="30" width="480" height="490" as="geometry" />
        </mxCell>
        <mxCell id="gsf8s2of0xvNhI0GVoiF-1" value="&lt;h1&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;PASAJE A TABLAS&lt;/font&gt;&lt;/h1&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;Pais(CodPais, NomPais, Continente)&lt;br&gt;Autor(CodAutor, NomA, FechaNacA, FechaDefA, CodP)&lt;br&gt;&lt;br&gt;FK - CodP de País&lt;br&gt;Editorial(NomEditorial, Direccion, NomUsuE, PassUsuE, CodP)&lt;br&gt;&lt;br&gt;FK - CodP de País&lt;br&gt;Librería(RUT, NomLib, NomUsuL, PassUsuL)&lt;br&gt;Solicitud(idSolicitud, FechaSolicitud, FechaEntrega,&amp;nbsp;RUT)&lt;br&gt;&lt;br&gt;FK -&amp;nbsp;RUT&amp;nbsp;de Librería&lt;br&gt;Libros(ISBN, NomLib, Genero, Reseña, Stock, CodAutor, NomEditorial)&lt;br&gt;&lt;br&gt;FK -&amp;nbsp;CodAutor&amp;nbsp;de Autor&lt;br&gt;&lt;br&gt;FK -&amp;nbsp;NomEditorial&amp;nbsp;de Editorial&lt;br&gt;Detalles(idSolicitud, ISBN, CantidadLibro)&lt;br&gt;&lt;br&gt;FK - idSolicitud de Solicitud&lt;br&gt;&lt;br&gt;FK - ISBN de Libro&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;Optimizamos&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;Origen: País - Autor&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;Ubicada: País - Editorial&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;Publican: Editorial - Libro&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;Realizan: Librería - Solicitud&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;Escribe: Autor - Libro&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;Relación no optimizada:&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;Incluye: Solicitud - Libro&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;No se optimizó porque es N:N y tiene el atributo Cantidad.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;Por eso se crea la tabla Incluye.&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;labelBackgroundColor=light-dark(#000000, #1ba1e2);textShadow=0;horizontal=1;fontColor=default;labelBorderColor=none;html=1;" parent="1" vertex="1">
          <mxGeometry x="590" y="-45" width="380" height="640" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
